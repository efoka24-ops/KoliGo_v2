{
  "expo": {
    "name": "KoliGo",
    "slug": "koligo",
    "scheme": "koligo",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/koligo-logo-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/koligo-logo-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E2A1C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cm.koligo.app"
    },
    "android": {
      "package": "cm.koligo.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/koligo-logo-1024.png",
        "backgroundColor": "#0E2A1C"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA8J-zFffiVc2pjQj5Ut4Qf4MlMMMfBc7A"
        }
      }
    },
    "web": {
      "favicon": "./assets/koligo-logo-1024.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-font",
      "./plugins/with-cleartext.js",
      [
        "expo-media-library",
        {
          "photosPermission": "KoliGo n'accède pas à vos photos.",
          "savePhotosPermission": "KoliGo enregistre vos reçus dans votre galerie.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
