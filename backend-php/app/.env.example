# Copier en app/.env (hors racine web) et remplir. Ne jamais commiter .env.
APP_BASE_URL=https://koligo.trugroup.cm

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# En local : DB_DRIVER=sqlite  (fichier app/storage/koligo.sqlite)

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# Sungku (passerelle mobile money). Cle et secret propres a CE projet.
SUNGKU_BASE_URL=https://sungku.trugroup.cm
SUNGKU_API_KEY=
SUNGKU_WEBHOOK_SECRET=
# true = aucun appel reel a Sungku (tests uniquement)
PAYMENT_MOCK=false

# true = renvoie l'OTP dans la reponse (l'appli le saisit seule). Voir Accounts::sendOtp.
OTP_RETURN_CODE=true

MAIL_FROM=noreply@trugroup.cm
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_FROM=
GOOGLE_MAPS_KEY=
