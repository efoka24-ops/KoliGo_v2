generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums — all enum-like fields use String with validated values at app layer.
// Role:            VENDOR | DELIVERER | ADMIN
// KycStatus:       NONE | PENDING | VERIFIED | REJECTED
// DelivererType:   TEMPORAIRE | PERMANENT | EXPRESS | VVIP | INTERURBAIN | FROID_FRAGILE
// DeliveryStatus:  EN_ATTENTE | ACCEPTE | EN_ROUTE | LIVRE | ANNULE
// PaymentProvider: MTN | ORANGE
// TransactionType: EARNING | WITHDRAWAL | COMMISSION | REFUND

model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  email           String?
  name            String
  pinHash         String
  roles           String    @default("VENDOR")   // JSON array: ["VENDOR"]
  activeRole      String    @default("VENDOR")
  kycStatus           String    @default("NONE")
  kycRejectionReason  String?
  gender          String?   // HOMME | FEMME
  biometryEnabled Boolean   @default(false)
  language        String    @default("fr")
  theme           String    @default("light")
  isBlocked       Boolean   @default(false)
  isOnline        Boolean   @default(false)
  expoPushToken   String?
  cniNumber       String?
  quartier        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  kycDocuments        KycDocument[]
  vendorDeliveries    Delivery[]    @relation("VendorDeliveries")
  delivererDeliveries Delivery[]    @relation("DelivererDeliveries")
  wallet              Wallet?
  ratingsGiven        Rating[]      @relation("RatingsGiven")
  ratingsReceived     Rating[]      @relation("RatingsReceived")
  issues              Issue[]
}

model KycDocument {
  id        String   @id @default(cuid())
  userId    String
  type      String   // ID_FRONT | ID_BACK | SELFIE
  filePath  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Delivery {
  id               String   @id @default(cuid())
  vendorId         String
  delivererId      String?
  pickupAddress    String
  dropoffAddress   String
  weightKg         Float
  distanceKm       Float?
  description      String?
  delivererType    String   @default("TEMPORAIRE")
  status           String   @default("EN_ATTENTE")
  collectCode      String
  deliverCode      String
  clientToken      String   @unique
  priceXAF         Int
  commissionXAF    Int
  delivererEarning Int
  momoRef          String?
  shopName         String?
  recipientName    String?
  recipientPhone   String?
  productPriceXAF  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor    User          @relation("VendorDeliveries",   fields: [vendorId],    references: [id])
  deliverer User?         @relation("DelivererDeliveries", fields: [delivererId], references: [id])
  escrow    EscrowEntry?
  locations GpsLocation[]
  ratings   Rating[]
  issues    Issue[]
  messages  Message[]
}

model Message {
  id         String   @id @default(cuid())
  deliveryId String
  senderId   String?
  senderName String
  senderRole String   // vendor | deliverer | recipient
  content    String
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model EscrowEntry {
  id         String    @id @default(cuid())
  deliveryId String    @unique
  amountXAF  Int
  lockedAt   DateTime  @default(now())
  releasedAt DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id])
}

model GpsLocation {
  id         String   @id @default(cuid())
  deliveryId String
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])
}

model Wallet {
  id              String    @id @default(cuid())
  userId          String    @unique
  balanceXAF      Int       @default(0)
  paymentProvider String    @default("MTN")
  paymentPhone    String?
  updatedAt       DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  withdrawals  Withdrawal[]
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // EARNING | WITHDRAWAL | COMMISSION | REFUND
  amountXAF   Int
  description String?
  deliveryId  String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model Withdrawal {
  id          String   @id @default(cuid())
  walletId    String
  amountXAF   Int
  provider    String   // MTN | ORANGE
  phone       String
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED
  externalRef String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model Rating {
  id         String   @id @default(cuid())
  deliveryId String
  fromUserId String
  toUserId   String
  score      Int
  tags       String?  // JSON array: ["Rapide","Pro"]
  comment    String?
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  from     User     @relation("RatingsGiven",    fields: [fromUserId], references: [id])
  to       User     @relation("RatingsReceived", fields: [toUserId],   references: [id])
}

model Issue {
  id          String   @id @default(cuid())
  deliveryId  String
  userId      String
  type        String   // DAMAGED | MISSING | WRONG_ADDRESS
  description String?
  photoPaths  String?  // JSON array
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt   DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  user     User     @relation(fields: [userId],     references: [id])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model City {
  id            String         @id @default(cuid())
  name          String         @unique
  region        String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  neighborhoods Neighborhood[]
}

model Neighborhood {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id])

  @@unique([name, cityId])
}

model DbArchive {
  id          String   @id @default(cuid())
  label       String
  archivedAt  DateTime @default(now())
  snapshotJson String  // JSON snapshot of counts before reset
  archivedBy  String?  // admin userId
}
