PORT=3000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET=change_me_access_secret_32chars
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
REDIS_URL=redis://localhost:6379
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
TWILIO_SID=
TWILIO_AUTH=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
UPLOAD_DIR=./uploads

# ─── Paiement ────────────────────────────────────────────────────────────────
# Selectionne l'implementation au demarrage : camoo | apisungku
PAYMENT_PROVIDER=apisungku

# Passerelle apisungku. KoliGo ne detient aucun secret d'operateur : la
# passerelle est seule a parler a pawaPay.
APISUNGKU_BASE_URL=https://apisungku.trugroup.cm/v1
# Fournies a l'enrolement du projet (POST /v1/projects), affichees une seule fois.
APISUNGKU_API_KEY=
APISUNGKU_WEBHOOK_SECRET=
